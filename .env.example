# Public site URL (used for sitemap, Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://www.lukassvendsen.dk

# Resend API key — required for contact and booking forms in production
RESEND_API_KEY=

# Where form submissions are delivered / sent from
BOOKING_TO_EMAIL=kontakt@lukassvendsen.dk
BOOKING_FROM_EMAIL=kontakt@lukassvendsen.dk

# Optional: Sanity CMS (leave unset to use local project data)
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
