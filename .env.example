# Public site URL (sitemap, Open Graph, canonicals)
NEXT_PUBLIC_SITE_URL=https://www.lukassvendsen.dk

# Resend — required for contact + booking forms in production
RESEND_API_KEY=

# Where form submissions are delivered / sent from
BOOKING_TO_EMAIL=kontakt@lukassvendsen.dk
BOOKING_FROM_EMAIL=kontakt@lukassvendsen.dk

# Optional: Cloudinary (only if using cloudinaryId on images)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Optional: Sanity CMS (leave unset to use local project data in src/lib/data)
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: Vercel AI Gateway (Lukas' assistent → google/gemini-2.5-flash)
# On Vercel, OIDC can work without a key. Locally set:
# AI_GATEWAY_API_KEY=
# Without credentials the assistant still answers with a safe rule-based fallback.
